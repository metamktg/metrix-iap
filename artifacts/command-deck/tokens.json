{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design tokens in the W3C Design Tokens (DTCG) format. THIS FILE IS THE SINGLE SOURCE OF TRUTH for the design system. Edit values here only -- do not hand-edit the generated src/index.css or src/generated/tokens.ts. The dev server regenerates them on every change (scripts/build-tokens.mjs, wired through vite.config.ts). Colors are authored as hex; the generator converts them to `H S% L%` channels for the web theme and keeps hex for mobile (tokens.ts). Every color role exists in both light and dark. Palette extracted from the Command Deck instrument-panel mockup: deep space-navy surfaces, sky-blue primary signal, cyan accent, mono terminal labels. Dark is the source-native mode; light is derived.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#f2f6fb" },
      "foreground": { "$value": "#0b1526" },
      "border": { "$value": "#c9d8e8" },
      "card": { "$value": "#ffffff" },
      "cardForeground": { "$value": "#0b1526" },
      "popover": { "$value": "#ffffff" },
      "popoverForeground": { "$value": "#0b1526" },
      "primary": {
        "$value": "#0369a1",
        "$description": "Signal blue (light-mode derivative of the deck's #38bdf8 accent-blue)."
      },
      "primaryForeground": { "$value": "#f2f6fb" },
      "secondary": { "$value": "#e2eaf3" },
      "secondaryForeground": { "$value": "#1e3a5f" },
      "muted": { "$value": "#e8eef6" },
      "mutedForeground": { "$value": "#4c6079" },
      "accent": { "$value": "#0e7490" },
      "accentForeground": { "$value": "#f2f6fb" },
      "destructive": { "$value": "#b91c1c" },
      "destructiveForeground": { "$value": "#ffffff" },
      "input": { "$value": "#c9d8e8" },
      "ring": { "$value": "#0369a1" },
      "chart1": { "$value": "#0369a1" },
      "chart2": { "$value": "#0e7490" },
      "chart3": { "$value": "#047857" },
      "chart4": { "$value": "#b45309" },
      "chart5": { "$value": "#64748b" },
      "sidebar": { "$value": "#e9f0f8" },
      "sidebarForeground": { "$value": "#33475e" },
      "sidebarBorder": { "$value": "#c9d8e8" },
      "sidebarPrimary": { "$value": "#0369a1" },
      "sidebarPrimaryForeground": { "$value": "#f2f6fb" },
      "sidebarAccent": { "$value": "#dbe6f2" },
      "sidebarAccentForeground": { "$value": "#0b1526" },
      "sidebarRing": { "$value": "#0369a1" }
    },
    "dark": {
      "background": { "$value": "#050a14" },
      "foreground": { "$value": "#e2e8f0" },
      "border": { "$value": "#16324e" },
      "card": { "$value": "#091224" },
      "cardForeground": { "$value": "#e2e8f0" },
      "popover": { "$value": "#0e1b35" },
      "popoverForeground": { "$value": "#e2e8f0" },
      "primary": {
        "$value": "#38bdf8",
        "$description": "Source-native accent-blue from the Command Deck mockup."
      },
      "primaryForeground": { "$value": "#050a14" },
      "secondary": { "$value": "#0e1b35" },
      "secondaryForeground": { "$value": "#8fa6c4" },
      "muted": { "$value": "#0b1526" },
      "mutedForeground": { "$value": "#8fa6c4" },
      "accent": { "$value": "#22d3ee" },
      "accentForeground": { "$value": "#050a14" },
      "destructive": { "$value": "#ef4444" },
      "destructiveForeground": { "$value": "#050a14" },
      "input": { "$value": "#16324e" },
      "ring": { "$value": "#38bdf8" },
      "chart1": { "$value": "#38bdf8" },
      "chart2": { "$value": "#22d3ee" },
      "chart3": { "$value": "#10b981" },
      "chart4": { "$value": "#f59e0b" },
      "chart5": { "$value": "#94a3b8" },
      "sidebar": { "$value": "#050d1a" },
      "sidebarForeground": { "$value": "#8fa6c4" },
      "sidebarBorder": { "$value": "#16324e" },
      "sidebarPrimary": { "$value": "#38bdf8" },
      "sidebarPrimaryForeground": { "$value": "#050a14" },
      "sidebarAccent": { "$value": "#0e1b35" },
      "sidebarAccentForeground": { "$value": "#e2e8f0" },
      "sidebarRing": { "$value": "#38bdf8" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Inter", "sans-serif"],
        "$description": "Default UI and body typeface (source: Command Deck mockup)."
      },
      "serif": { "$value": ["Georgia", "serif"] },
      "mono": {
        "$value": ["Share Tech Mono", "monospace"],
        "$description": "Terminal readout face used for labels, metrics, and codes."
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.125rem",
      "$description": "Near-square corners -- the source mockup uses hard-edged instrument panels."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step components multiply."
    }
  }
}
