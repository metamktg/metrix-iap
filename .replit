[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 90000

[userenv]

[userenv.shared]
NEXT_PUBLIC_SUPABASE_ANON_KEY = "sb_publishable_l9AOy2hiDMd7BbVB3T_x5w_X7JyPLZ-"
PILOT_MODE = "true"
PILOT_REQUIRED_AD_ACCOUNT_ID = "act_1202182091204847"
REQUEST_ACCESS_FROM_EMAIL = "Metrix <no-reply@notifications.metrix.ad>"

[nix]
channel = "stable-25_05"
packages = ["q"]

[[ports]]
localPort = 8080
externalPort = 8080

