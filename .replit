modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "api-smoke"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "iap-build"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "api-server-tests"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "api-codegen-drift"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "scripts-tests"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "metrix-iap-build"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "marketing-build"

[[workflows.workflow]]
name = "api-smoke"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts run smoke:api-server"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "iap-build"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts run smoke:metrix-iap-build"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "api-server-tests"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run test"

[[workflows.workflow]]
name = "api-codegen-drift"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts run check:api-codegen-drift"

[[workflows.workflow]]
name = "scripts-tests"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts run test"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "metrix-iap-build"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts run smoke:metrix-iap-build"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "marketing-build"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts run smoke:marketing-build"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]
NEXT_PUBLIC_SUPABASE_URL = "lqryrmaipryeqtjbxjdh.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY = "sb_publishable_l9AOy2hiDMd7BbVB3T_x5w_X7JyPLZ-"
PILOT_MODE = "true"
PILOT_REQUIRED_AD_ACCOUNT_ID = "act_1202182091204847"
REQUEST_ACCESS_FROM_EMAIL = "Metrix <no-reply@notifications.metrix.ad>"

[nix]
channel = "stable-25_05"
