args = "signal-weights-drift"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "type-scale"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "chart-palette"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "command-deck-token-drift"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "communications-section-icons"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "generation-runs-migration"

[[workflows.workflow]]
name = "api-smoke"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts run smoke:api-server"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "api-server-tests"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
