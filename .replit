modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "api-smoke"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "iap-build"

[[workflows.workflow]]
name = "api-smoke"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts run smoke:api-server"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "iap-build"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts run smoke:metrix-iap-build"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]
NEXT_PUBLIC_SUPABASE_URL = "lqryrmaipryeqtjbxjdh.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY = "sb_publishable_l9AOy2hiDMd7BbVB3T_x5w_X7JyPLZ-"

[nix]
channel = "stable-25_05"
