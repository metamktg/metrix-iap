modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "api-smoke"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "api-server-tests"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "api-codegen-drift"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "scripts-tests"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "metrix-iap-build"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "marketing-build"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "metrix-iap-nav-routes"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "seed-fixture-drift"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "text-primary-contrast"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "css-token-contrast"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "text-muted-contrast"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "marketing-form-e2e"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "command-deck-contrast"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "command-deck-contrast"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "disclosure-rulebook"

[[workflows.workflow.tasks]]
